# cp .env.example .env

# Anthropic (parser IA) — OBRIGATORIO
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Z-API (WhatsApp) — preencher apos criar conta em z-api.io
ZAPI_INSTANCE_ID=
