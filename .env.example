# Copie este arquivo para .env e preencha com suas chaves
# cp .env.example .env

# Anthropic (parser IA) — OBRIGATORIO
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Supabase (usuarios, historico, sugestoes) — OBRIGATORIO em producao
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# Z-API (WhatsApp) — preencher apos criar conta em z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Numero do bot no WhatsApp (somente numeros, com DDI+DDD)
# Ex: 5511999999999
WHATSAPP_BOT_PHONE=
